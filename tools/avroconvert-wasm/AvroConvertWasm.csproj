<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- AvroConvert Online engine: the AvroConvert NuGet package compiled to WebAssembly and called from the Astro pages
       through [JSExport]. Everything runs in the visitor's browser; no data is sent anywhere.
       Built by `npm run build:wasm` into public/avroconvert/online/_framework (git-ignored). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Trim warnings for AvroConvert and Newtonsoft are expected: both assemblies are kept whole below. -->
    <NoWarn>$(NoWarn);CA1416;IL2026;IL3050;IL2104</NoWarn>
    <WasmEnableWebcil>true</WasmEnableWebcil>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in sync with the AvroConvert release shown on the site. -->
    <PackageReference Include="AvroConvert" Version="4.0.0-preview.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- AvroConvert maps types and builds serializers by reflection; trimming must not remove what it reflects on. -->
    <TrimmerRootAssembly Include="SolTechnology.Avro" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
