---
import { site } from "../config";
const links = [
  { href: "/#products", label: "Products" },
  { href: "/contact", label: "Contact" },
  { href: site.github, label: "GitHub", external: true, desktopOnly: true },
];
const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes("#") && !href.startsWith("http") && path.replace(/\/$/, "") === href.replace(/\/$/, "");
---
<header class="sticky top-0 z-40 bg-ink text-white border-b border-white/10">
  <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between">
    <a href="/" class="flex shrink-0 items-center gap-2 sm:gap-3" aria-label={site.name}>
      <img src="/brand/mark-dark.svg" alt="" width="34" height="34" class="w-[30px] h-[30px] sm:w-[34px] sm:h-[34px]" />
      <span class="text-lg sm:text-xl tracking-tight whitespace-nowrap"><span class="font-bold text-solar">sol</span><span class="font-normal">technology</span></span>
    </a>
    <nav class="flex items-center sm:gap-1 text-sm">
      {links.map((l) => (
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noopener" : undefined}
          class:list={[
            "px-2 sm:px-3 py-2 rounded-md whitespace-nowrap hover:bg-white/10 transition",
            l.desktopOnly && "hidden sm:inline-block",
            isActive(l.href) ? "text-solar" : "text-white/85",
          ]}
        >{l.label}</a>
      ))}
    </nav>
  </div>
</header>
