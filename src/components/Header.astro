---
import { site } from "../config";
const links = [
  { href: "/avroconvert", label: "AvroConvert" },
  { href: "/avroconvert#pricing", label: "Pricing" },
  { href: "/#services", label: "Services" },
  { href: site.github, label: "GitHub", external: true },
  { href: "/contact", label: "Contact" },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 bg-ink text-white border-b border-white/10">
  <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3" aria-label={site.name}>
      <img src="/brand/mark-dark.svg" alt="" width="34" height="34" />
      <span class="text-xl tracking-tight"><span class="font-bold text-solar">sol</span><span class="font-normal">technology</span></span>
    </a>
    <nav class="flex items-center gap-1 text-sm">
      {links.map((l) => (
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noopener" : undefined}
          class:list={[
            "px-3 py-2 rounded-md hover:bg-white/10 transition",
            path.startsWith(l.href.split("#")[0]) && l.href !== "/" && !l.external ? "text-solar" : "text-white/85",
          ]}
        >{l.label}</a>
      ))}
    </nav>
  </div>
</header>
