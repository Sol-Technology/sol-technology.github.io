---
import Base from "../layouts/Base.astro";
import { site, products, pricing, paddle } from "../config";
const p = products.find((x) => x.slug === "avroconvert")!;
const paddleReady = Boolean(paddle.clientToken);

const features = [
  ["Serialize / Deserialize", "byte[] avro = AvroConvert.Serialize(obj);\nvar back = AvroConvert.Deserialize<MyType>(avro);"],
  ["Native .NET types", "Dictionary, List, DateTime, Guid, decimal, enums, nullable and records – no generated classes required."],
  ["Schema tooling", "AvroConvert.GenerateSchema(typeof(T));\nAvroConvert.GenerateModel(avroOrSchema);"],
  ["Streaming", "using var reader = AvroConvert.OpenDeserializer<T>(stream);\nwhile (reader.HasNext()) Process(reader.ReadNext());"],
  ["Codecs", "Deflate · Snappy · GZip · Brotli — pick per call, read any."],
  ["JSON bridge", "AvroConvert.Avro2Json(avro); AvroConvert.Json2Avro(json, schema);"],
];
---
<Base title="AvroConvert" description={p.short} image="/brand/avroconvert-og-image.png" favicon="/brand/avroconvert-favicon.svg">
  <section class="bg-ink text-white">
    <div class="mx-auto max-w-6xl px-5 py-20 grid gap-10 md:grid-cols-[1.3fr_1fr] items-center">
      <div>
        <div class="flex items-center gap-3 text-sm text-white/60"><a href="/" class="hover:text-white">soltechnology</a><span>/</span><span class="text-white">AvroConvert</span></div>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold tracking-tight">Rapid Apache Avro serializer for .NET</h1>
        <p class="mt-5 text-lg text-white/75 max-w-xl">Avro combines the readability of JSON with the size of binary. AvroConvert brings it to .NET with native types, schema generation, codecs and streaming – one static class, no code generation.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#pricing" class="rounded-lg bg-solar px-5 py-3 font-semibold text-ink hover:bg-solar-dark transition">Pricing &amp; licence</a>
          <a href={p.nuget} target="_blank" rel="noopener" class="rounded-lg border border-white/20 px-5 py-3 font-medium hover:bg-white/10 transition">NuGet</a>
          <a href={p.docs} target="_blank" rel="noopener" class="rounded-lg border border-white/20 px-5 py-3 font-medium hover:bg-white/10 transition">Documentation</a>
        </div>
        <pre class="mt-8 rounded-xl bg-black/40 border border-white/10 p-4 text-sm font-mono text-white/90 overflow-x-auto"><code>dotnet add package AvroConvert</code></pre>
      </div>
      <div class="flex justify-center md:justify-end"><img src={p.markDark} alt="" width="220" height="220" /></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-6 md:grid-cols-3">
      {features.map(([t, c]) => (
        <div class="rounded-2xl border border-line p-6">
          <h3 class="font-semibold">{t}</h3>
          <pre class="mt-3 text-[13px] leading-6 font-mono text-ink/80 whitespace-pre-wrap">{c}</pre>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-mist">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-bold tracking-tight">Why Avro, why AvroConvert</h2>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-line bg-white">
        <table class="w-full text-sm">
          <thead class="bg-mist text-left"><tr><th class="px-4 py-3"></th><th class="px-4 py-3">AvroConvert</th><th class="px-4 py-3">Apache.Avro</th><th class="px-4 py-3">Newtonsoft.Json</th></tr></thead>
          <tbody class="[&_td]:px-4 [&_td]:py-3 [&_tr]:border-t [&_tr]:border-line">
            <tr><td>Native C# types (Dictionary, List, DateTime…)</td><td>✔</td><td>—</td><td>✔</td></tr>
            <tr><td>Binary, schema-described payload</td><td>✔</td><td>✔</td><td>—</td></tr>
            <tr><td>Compression codecs</td><td>Deflate, Snappy, GZip, Brotli</td><td>Deflate</td><td>—</td></tr>
            <tr><td>Schema ⇄ C# model generation</td><td>✔</td><td>avrogen tool</td><td>—</td></tr>
            <tr><td>Payload size (200 × 200 nested records)</td><td>2.6 MB · 104 kB gzip</td><td>—</td><td>6.0 MB · 514 kB gzip</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-muted">Benchmark data from the repository’s <a class="underline" href={`${p.repo}/blob/master/docs/articles/GrandeBenchmark.ImplementationsBattleRoyal-report.html`} target="_blank" rel="noopener">BenchmarkDotNet report</a>. Version 4.0 (in progress) targets .NET 10 with a rewritten allocation-free core.</p>
    </div>
  </section>

  <section id="pricing" class="mx-auto max-w-6xl px-5 py-20 scroll-mt-20">
    <h2 class="text-2xl font-bold tracking-tight">Pricing</h2>
    <p class="mt-2 text-muted max-w-2xl">One library, one licence per organisation. Free for individuals, open source and small businesses; annual licences for everyone else. Prices in {pricing.currency}, excluding VAT, which is handled at checkout.</p>
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {pricing.tiers.map((t) => (
        <div class:list={["rounded-2xl border p-6 flex flex-col", t.highlight ? "border-solar ring-2 ring-solar/30" : "border-line"]}>
          <h3 class="text-lg font-semibold">{t.name}</h3>
          <p class="mt-1 text-sm text-muted min-h-10">{t.for}</p>
          <p class="mt-5"><span class="text-3xl font-bold tracking-tight">{t.price === 0 ? "Free" : `$${t.price.toLocaleString("en-US")}`}</span> <span class="text-muted text-xs">{t.period}</span></p>
          <ul class="mt-5 space-y-2 text-[14px] flex-1">{t.bullets.map((b) => <li class="flex gap-2"><span class="text-solar">✔</span><span>{b}</span></li>)}</ul>
          <p class="mt-5 text-xs text-muted">{t.license}</p>
          {"paddlePrice" in t.cta ? (
            paddleReady ? (
              <button type="button" class="mt-4 rounded-lg bg-ink text-white px-4 py-3 font-semibold hover:bg-ink-2 transition" data-paddle-price={paddle.prices[t.cta.paddlePrice as keyof typeof paddle.prices]}>{t.cta.label}</button>
            ) : (
              <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(`AvroConvert ${t.name} licence`)}`} class="mt-4 rounded-lg bg-ink text-white px-4 py-3 font-semibold text-center hover:bg-ink-2 transition">{t.cta.label}</a>
            )
          ) : (
            <a href={t.cta.href} target="_blank" rel="noopener" class="mt-4 rounded-lg border border-ink px-4 py-3 font-semibold text-center hover:bg-mist transition">{t.cta.label}</a>
          )}
        </div>
      ))}
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 text-[15px]">
      <div class="rounded-2xl bg-mist p-6">
        <h3 class="font-semibold">Who needs a commercial licence?</h3>
        <p class="mt-2 text-ink/80">Any organisation that does not qualify for PolyForm Noncommercial or PolyForm Small Business – in short, companies with 100 or more people <em>or</em> USD 1M or more in annual revenue (including affiliates). Evaluation and development against the library is always free.</p>
      </div>
      <div class="rounded-2xl bg-mist p-6">
        <h3 class="font-semibold">What you get after purchase</h3>
        <p class="mt-2 text-ink/80">A licence key by e-mail within minutes, a VAT invoice from Paddle, and the right to use every version released during your subscription in perpetuity. Renewals keep you on new releases. Need a quote, PO or bank transfer? <a class="underline" href="/contact">Contact us</a>.</p>
      </div>
    </div>
  </section>

  {paddleReady && (
    <>
      <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
      <script is:inline define:vars={{ env: paddle.environment, token: paddle.clientToken }}>
        if (env === "sandbox") Paddle.Environment.set("sandbox");
        Paddle.Initialize({ token });
        document.querySelectorAll("[data-paddle-price]").forEach((b) =>
          b.addEventListener("click", () => Paddle.Checkout.open({ items: [{ priceId: b.dataset.paddlePrice, quantity: 1 }] })));
      </script>
    </>
  )}
</Base>
