---
import Tool from "../../../layouts/Tool.astro";
---
<Tool slug="schema-compatibility">
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <label class="tool-label" for="mode">Compatibility mode</label>
    <select id="mode" class="tool-select">
      <option value="Backward" selected>BACKWARD – the new schema reads data written with the previous one</option>
      <option value="Forward">FORWARD – the previous schema reads data written with the new one</option>
      <option value="Full">FULL – both directions</option>
    </select>
    <button id="example" class="tool-button" type="button">Load example</button>
    <button id="swap" class="tool-button" type="button">Swap</button>
    <button id="share" class="tool-button" type="button">Share link</button>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div>
      <label class="tool-label block mb-2" for="previous">Previous schema <span class="font-normal text-muted">(registered / in production)</span></label>
      <div id="previous"></div>
    </div>
    <div>
      <label class="tool-label block mb-2" for="next">New schema</label>
      <div id="next"></div>
    </div>
  </div>
  <div id="error" class="tool-error" hidden></div>

  <div id="result" class="mt-8" hidden>
    <div id="verdict" class="rounded-2xl px-6 py-5"></div>
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div>
        <h2 class="font-semibold">New schema reading old data</h2>
        <ul id="new-reads-old" class="mt-2 space-y-2"></ul>
      </div>
      <div>
        <h2 class="font-semibold">Old schema reading new data</h2>
        <ul id="old-reads-new" class="mt-2 space-y-2"></ul>
      </div>
    </div>
    <details class="mt-8 rounded-xl border border-line p-4">
      <summary class="cursor-pointer font-semibold">Canonical form and fingerprints</summary>
      <div id="fingerprints" class="mt-4 grid gap-6 lg:grid-cols-2 text-[13px]"></div>
      <p class="mt-3 text-xs text-muted">Parsing Canonical Form and its CRC-64-AVRO (Rabin) fingerprint from the Avro specification. Two schemas with the same canonical form read and write identical bytes.</p>
    </details>
  </div>

  <pre slot="code" class="mt-3 rounded-lg bg-ink text-white/90 px-3 py-2 text-[13px] font-mono overflow-x-auto"><code>AvroSchema.CheckCompatibility(previous, next,
    AvroCompatibilityMode.Backward);</code></pre>
</Tool>

<script>
  import { attempt, startEngine } from "../../../lib/avro-engine";
  import { createEditor } from "../../../lib/editor";
  import { $, debounce, sharedState, showError, stored, wireShareButton } from "../../../lib/tool-utils";

  type Difference = { path: string; kind: string; breaking: boolean; description: string };

  const v1 = {
    type: "record", name: "Customer", namespace: "Crm",
    fields: [
      { name: "Id", type: "long" },
      { name: "Name", type: "string" },
      { name: "Email", type: "string" },
      { name: "Tier", type: { type: "enum", name: "Tier", symbols: ["Free", "Pro"] } },
    ],
  };
  const v2 = {
    type: "record", name: "Customer", namespace: "Crm",
    fields: [
      { name: "Id", type: "long" },
      { name: "Name", type: "string" },
      { name: "Phone", type: ["null", "string"], default: null },
      { name: "Tier", type: { type: "enum", name: "Tier", symbols: ["Free", "Pro", "Enterprise"], default: "Free" } },
      { name: "CreatedAt", type: { type: "long", logicalType: "timestamp-millis" } },
    ],
  };

  const engine = await startEngine();
  const errorBox = $("#error");
  const modeSelect = $<HTMLSelectElement>("#mode");

  const list = (target: HTMLElement, differences: Difference[]) => {
    target.replaceChildren(
      ...(differences.length ? differences : [null]).map((d) => {
        const li = document.createElement("li");
        li.className = "rounded-lg border px-4 py-3 text-sm";
        if (!d) {
          li.classList.add("border-line", "text-muted");
          li.textContent = "No differences.";
          return li;
        }
        li.classList.add(...(d.breaking ? ["border-red-200", "bg-red-50"] : ["border-line", "bg-white"]));
        li.innerHTML = `<div class="flex flex-wrap items-center gap-2"><code class="font-mono text-[13px] font-semibold"></code><span class="rounded px-1.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide"></span></div><p class="mt-1 text-ink/80"></p>`;
        li.querySelector("code")!.textContent = d.path || "(root)";
        const badge = li.querySelector("span")!;
        const kind = d.kind.replace(/([a-z])([A-Z])/g, "$1 $2").toLowerCase();
        badge.textContent = d.breaking ? `breaking · ${kind}` : kind;
        badge.classList.add(...(d.breaking ? ["bg-red-600", "text-white"] : ["bg-mist", "text-muted"]));
        li.querySelector("p")!.textContent = d.description;
        return li;
      }),
    );
  };

  const fingerprintBlock = (title: string, schema: string) => {
    const result = attempt(() => JSON.parse(engine.Fingerprints(schema)));
    const div = document.createElement("div");
    div.innerHTML = `<h3 class="font-semibold text-sm"></h3><pre class="mt-2 whitespace-pre-wrap break-all rounded-lg bg-mist p-3 font-mono"></pre><dl class="mt-2 grid grid-cols-[6rem_1fr] gap-1 font-mono"></dl>`;
    div.querySelector("h3")!.textContent = title;
    if (!result.value) return div;
    div.querySelector("pre")!.textContent = result.value.canonicalForm;
    const dl = div.querySelector("dl")!;
    for (const [label, value] of [["CRC-64", `${result.value.crc64} (${result.value.crc64Long})`], ["SHA-256", result.value.sha256]]) {
      const dt = document.createElement("dt");
      dt.className = "text-muted";
      dt.textContent = label;
      const dd = document.createElement("dd");
      dd.className = "break-all";
      dd.textContent = value;
      dl.append(dt, dd);
    }
    return div;
  };

  const check = () => {
    const [a, b] = [previous.get().trim(), next.get().trim()];
    stored.set("compat", JSON.stringify({ previous: a, next: b, mode: modeSelect.value }));
    if (!a || !b) return;
    const result = attempt(() => JSON.parse(engine.CheckCompatibility(a, b, modeSelect.value)));
    showError(errorBox, result.error);
    $("#result").hidden = !!result.error;
    if (result.error) return;

    const r = result.value;
    const verdict = $("#verdict");
    verdict.className = `rounded-2xl px-6 py-5 ${r.compatible ? "bg-emerald-50 border border-emerald-200" : "bg-red-50 border border-red-200"}`;
    verdict.innerHTML = `<p class="text-xl font-semibold"></p><p class="mt-1 text-sm text-ink/80"></p>`;
    verdict.children[0].textContent = r.equivalent
      ? "Equivalent – both schemas read and write the same data"
      : r.compatible ? `Compatible (${r.mode.toUpperCase()})` : `Not compatible (${r.mode.toUpperCase()})`;
    verdict.children[1].textContent = r.compatible
      ? "A schema registry with this compatibility setting accepts the new schema."
      : `${r.incompatibilities.length} breaking change${r.incompatibilities.length === 1 ? "" : "s"}. A schema registry with this compatibility setting rejects the new schema.`;
    list($("#new-reads-old"), r.newReadsOld);
    list($("#old-reads-new"), r.oldReadsNew);
    $("#fingerprints").replaceChildren(fingerprintBlock("Previous", a), fingerprintBlock("New", b));
  };
  const checkSoon = debounce(check, 300);

  const previous = createEditor($("#previous"), { language: "json", minHeight: "20rem", onChange: checkSoon, onRun: check });
  const next = createEditor($("#next"), { language: "json", minHeight: "20rem", onChange: checkSoon, onRun: check });

  modeSelect.addEventListener("change", check);
  $("#example").addEventListener("click", () => {
    previous.set(JSON.stringify(v1, null, 2));
    next.set(JSON.stringify(v2, null, 2));
    check();
  });
  $("#swap").addEventListener("click", () => {
    const a = previous.get();
    previous.set(next.get());
    next.set(a);
    check();
  });
  wireShareButton($("#share"), () => ({ previous: previous.get(), next: next.get(), mode: modeSelect.value }));

  const saved = (await sharedState()) ?? attempt(() => JSON.parse(stored.get("compat") ?? "null")).value;
  previous.set(saved?.previous ?? JSON.stringify(v1, null, 2));
  next.set(saved?.next ?? JSON.stringify(v2, null, 2));
  if (saved?.mode) modeSelect.value = saved.mode;
  check();
</script>
